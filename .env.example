GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MILVUS_DB_PATH=./data/milvus.db
COLLECTION_NAME=docs_rag
DOCS_DIR=./docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Comma-separated origins allowed to call the API directly from a browser.
# Add https://<your-lan-ip>:5174 if other machines call the backend directly.
CORS_ORIGINS=https://localhost:5174,https://127.0.0.1:5174

# Voice (Gemini Live API)
GEMINI_API_KEY=your_gemini_api_key_here
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Kore
# agent: Gemini searches the docs and answers; rag: Gemini reads the answer from the RAG chain
LIVE_ANSWER_MODE=agent
# vad: hands-free; ptt: push-to-talk
LIVE_TALK_MODE=vad
